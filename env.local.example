# 구글 서비스 계정 이메일 (예: raon-science@your-project.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# 구글 서비스 계정 Private Key
# JSON 키 파일의 private_key 값을 그대로 붙여넣으세요.
# 로컬(.env.local)에서는 반드시 큰따옴표로 감싸주세요.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (선택) 신청 데이터를 저장할 구글 시트 ID. 비워두면 코드의 기본값 시트를 사용합니다.
GOOGLE_SHEET_ID=

# ---- 솔라피(SOLAPI) 문자 발송 ----
# 솔라피 콘솔(https://console.solapi.com) > API Key 관리 에서 발급
solapi_api_key=
solapi_api_key_secret=

# 솔라피 콘솔에 "발신번호"로 등록/본인인증 완료된 번호 (하이픈 없이 숫자만, 예: 01012345678)
# 등록되지 않은 번호는 발신 자체가 거부됩니다.
# 주의: 변수명이 solapi_sender_unmber 입니다 (Vercel에 이미 이 이름으로 등록하신 상태라 코드도 맞췄습니다).
solapi_sender_unmber=

# 신청 접수 알림을 받을 관리자(원장님) 번호. 여러 명이면 콤마(,)로 구분 (예: 01011112222,01033334444)
# 비워두면 관리자 알림 문자는 발송하지 않습니다.
# 주의: 변수명이 admin_phone_numer 입니다 (Vercel에 이미 이 이름으로 등록하신 상태라 코드도 맞췄습니다).
admin_phone_numer=
